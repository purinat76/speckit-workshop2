{
  "name": "photo-album-organizer",
  "version": "1.0.0",
  "description": "A web application for organizing and browsing local photos in albums grouped by capture date.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write \"src/**/*.{js,json,html,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,json,html,css}\"",
    "check": "npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "sql.js": "^1.8.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^1.0.0",
    "@vitest/ui": "^1.0.0",
    "eslint": "^8.54.0",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "jsdom": "^23.0.0",
    "prettier": "^3.1.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
